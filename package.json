{
  "name": "idealab",
  "version": "1.0.0",
  "private": true,
  "description": "IdeaLab — research, score, compare and track a portfolio of small niche software products.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/bootstrap.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --force",
    "db:setup": "tsx scripts/seed.ts",
    "test": "tsx --test scripts/test-merge.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
